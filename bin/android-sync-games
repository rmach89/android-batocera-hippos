#!/bin/bash
# Turns installed Android apps into EmulationStation entries (<roms>/*.android):
#   Batocera: /userdata/roms/android     HippOS: /userdata/roms/androidgames (Android Games)
# The app list is written by session.sh while Android is running (Waydroid can only list apps
# with a live session), so this reads that cache.
SELF="$(readlink -f "$0")"
. "$(dirname "$SELF")/android-common.sh"

CACHE="$ROMS_DIR/.cache/applist.txt"
MARK="# managed-by-android-addon"
mkdir -p "$ROMS_DIR" "$APK_DIR"

write_entry() {  # write_entry "<Display Name>" "<package>"
    printf '%s\n%s\n' "$MARK" "$2" > "$ROMS_DIR/$1.android"
}
# Play Store + APK manager live in the F1 Applications menu, not in the game list
rm -f "$ROMS_DIR/Google Play Store.android" "$ROMS_DIR/APK Installer - Uninstaller.android"

[ -s "$CACHE" ] || { echo "sync: no app list cached yet (start any Android entry once)"; exit 0; }

# System / framework packages that should not show up as games
# Which apps count as games: Android's own list of apps YOU installed (written by
# installed-apps.sh when you leave Android), so nothing is hidden just by its name.
# Older caches without that list fall back to name patterns.
USER_PKGS="$ROMS_DIR/.cache/user-packages.txt"
declare -A USER
if [ -s "$USER_PKGS" ]; then while read -r p; do [ -n "$p" ] && USER["$p"]=1; done < "$USER_PKGS"; fi

is_system_pkg() {
    case "$1" in
        org.fdroid.fdroid|org.fdroid.basic|com.aurora.store|cm.aptoide.pt|\
        com.android.vending) return 0 ;;                       # app stores live in the F1 menu
    esac
    if [ ${#USER[@]} -gt 0 ]; then
        [ -z "${USER[$1]}" ]                                   # not installed by you -> system app
        return
    fi
    case "$1" in
        android|android.*|com.android.*|com.google.android.*|com.google.*|org.lineageos.*|\
        id.waydro.*|org.chromium.*|com.qualcomm.*|org.codeaurora.*|com.waydroid.*) return 0 ;;
    esac
    return 1
}
# HippOS: games you dropped in Android Games as .apk files already have an entry - no duplicate
declare -A HAS_APK
if [ "$HOST_MODE" = 1 ]; then
    for f in "$ROMS_DIR"/*.apk "$ROMS_DIR"/*.APK; do
        [ -f "$f" ] || continue
        p="$(apk_package "$(readlink -f "$f")")"; [ -n "$p" ] && HAS_APK["$p"]=1
    done
fi

declare -A KEEP
name=""
while IFS= read -r line; do
    case "$line" in
        Name:*)        name="${line#Name: }" ;;
        packageName:*) pkg="${line#packageName: }"
                       pkg="$(echo "$pkg" | tr -d '[:space:]')"
                       if [ -n "$pkg" ] && ! is_system_pkg "$pkg" && [ -z "${HAS_APK[$pkg]}" ]; then
                           clean="$(echo "${name:-$pkg}" | tr -d '/\\:*?"<>|' | sed 's/^[ .]*//;s/[ .]*$//')"
                           [ -z "$clean" ] && clean="$pkg"
                           write_entry "$clean" "$pkg"
                           KEEP["$clean.android"]=1
                       fi
                       name="" ;;
    esac
done < "$CACHE"

# remove entries for apps that were uninstalled (only files this add-on created)
for f in "$ROMS_DIR"/*.android; do
    [ -e "$f" ] || continue
    b="$(basename "$f")"
    if head -n1 "$f" | grep -qx "$MARK" && [ -z "${KEEP[$b]}" ]; then
        rm -f "$f"; echo "sync: removed $b"
    fi
done
echo "sync: done (${#KEEP[@]} apps)"
fix_owner

# 3D jewel-case boxes + metadata (LaunchBox, ScreenScraper, Google Play, F-Droid) run in the background
# so returning to EmulationStation is never delayed. Skip with: --no-scrape
if [ "$1" != "--no-scrape" ] && [ -x "$ROOTFS/usr/bin/python3" ] && { [ "$HOST_MODE" = 1 ] || is_mounted "$ROOTFS/proc"; }; then
    # your ScreenScraper login saved in Batocera's scraper settings (raises ScreenScraper's quota)
    ES_CFG=/userdata/system/configs/emulationstation/es_settings.cfg
    ss_get() { sed -n "s/.*name=\"$1\" value=\"\([^\"]*\)\".*/\1/p" "$ES_CFG" 2>/dev/null | tail -n1; }
    SS_USER="$(ss_get ScreenScraperUser)"; SS_PASS="$(ss_get ScreenScraperPass)"
    ( in_chroot env SS_USER="$SS_USER" SS_PASS="$SS_PASS" \
        python3 /opt/android/scrape-launchbox.py ${FORCE_SCRAPE:+--force} >>"$LOG" 2>&1
      fix_owner; reload_es ) </dev/null >/dev/null 2>&1 &
fi
